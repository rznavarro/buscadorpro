# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube a git.

# --- IA (análisis de webs con puntaje) ---
# Mientras esté vacía, la IA queda APAGADA y no se gasta nada: la lista igual muestra los
# problemas que se detectan sin IA. Para activarla, pega aquí tu clave (empieza con sk-ant-).
ANTHROPIC_API_KEY=
# Modelo: claude-opus-5-5 (mejor criterio, ~US$0,15 por web) o claude-sonnet-5-5 (~la mitad).
LLM_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high (más alto = más preciso y más caro)
LLM_EFFORT=medium

# --- PageSpeed Insights (opcional) ---
PAGESPEED_API_KEY=

# --- Google Maps ---
# Región para normalizar teléfonos y abrir Maps (CL = Chile, AR = Argentina)
DEFAULT_REGION=CL
MAPS_LANGUAGE=es
SEARCH_LIMIT_DEFAULT=20
SEARCH_LIMIT_MAX=50
# Pausa aleatoria entre acciones en Maps (segundos)
DELAY_MIN_SECONDS=2
DELAY_MAX_SECONDS=6
# Segundos máximos de espera para que cargue una página de Maps
MAPS_TIMEOUT_SECONDS=20
# Abrir la pestaña "Información" de cada ficha (descripción y servicios) si existe
MAPS_OPEN_ABOUT_TAB=true
# Reintentar la ficha en vista móvil si no apareció un WhatsApp (más visitas a Google)
MAPS_MOBILE_RETRY=false
# Si una ficha no carga, cuántas veces más se intenta. Ante un captcha NUNCA se reintenta.
MAPS_RETRIES=1

# --- Análisis de webs ---
# Cuántas webs se analizan al mismo tiempo
WEB_CONCURRENCY=3
# No volver a analizar una web si se analizó hace menos de estos días
REANALYZE_AFTER_DAYS=30
# Segundos máximos de espera por cada página web
WEB_TIMEOUT_SECONDS=15
# Si una web no responde o falla un momento (error 500/502/503, "demasiadas visitas"),
# cuántas veces más se intenta y cuántos segundos se espera antes. Un 404 o un dominio
# que no existe no se reintentan.
WEB_RETRIES=1
WEB_RETRY_PAUSE_SECONDS=3
# Tiempo máximo total por web: comprobar si abre (y buscar su WhatsApp) y revisión a fondo
WEB_VERIFY_MAX_SECONDS=120
WEB_REVIEW_MAX_SECONDS=300
# Páginas internas (contacto, servicios, nosotros) donde también se busca el WhatsApp
WEB_MAX_INTERNAL_PAGES=3
# Cuántos enlaces internos e imágenes se revisan por si están rotos
WEB_MAX_LINKS_CHECK=20
WEB_MAX_IMAGES_CHECK=15
# Alto máximo (px) de la captura de página completa
SCREENSHOT_MAX_HEIGHT=6000

# --- Navegador ---
# false = se ve la ventana del navegador; true = trabaja sin ventana.
# Déjalo en false: sin ventana, Google Maps oculta el número de reseñas de cada negocio.
HEADLESS=false
# Ruta a un Chrome/Chromium específico. Vacío = el Chromium que instala Playwright.
BROWSER_EXECUTABLE_PATH=
# Telemetría anónima de Browser Use (desactivada por defecto)
BROWSER_USE_TELEMETRY=false

# --- Datos (base de datos, capturas y registros diarios en data/logs) ---
DATA_DIR=data
